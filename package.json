{
  "name": "yogoe-unity-tools",
  "private": true,
  "description": "Local tooling for Yogoe Unity (yut bubble / character sheets)",
  "scripts": {
    "yut-bubbles": "python3 Tools/export_yut_bubbles.py",
    "yut-bubbles:csv": "python3 Tools/export_yut_bubbles.py --csv Tools/sheets/yut_bubbles.csv",
    "yut-bubbles:to-csv": "python3 Tools/import_yut_bubbles_csv.py",
    "yut-bubbles:push": "python3 Tools/import_yut_bubbles_csv.py --push",
    "characters": "python3 Tools/export_characters.py",
    "characters:csv": "python3 Tools/export_characters.py --csv",
    "characters:to-csv": "python3 Tools/export_characters.py --to-csv",
    "characters:push": "python3 Tools/export_characters.py --push",
    "props": "python3 Tools/export_props.py",
    "props:csv": "python3 Tools/export_props.py --csv",
    "props:to-csv": "python3 Tools/export_props.py --to-csv",
    "props:push": "python3 Tools/export_props.py --push",
    "attendance": "python3 Tools/export_attendance.py",
    "attendance:csv": "python3 Tools/export_attendance.py --csv",
    "attendance:push": "python3 Tools/export_attendance.py --push",
    "recipes": "python3 Tools/export_recipes.py",
    "recipes:csv": "python3 Tools/export_recipes.py --csv",
    "recipes:push": "python3 Tools/export_recipes.py --push",
    "ingredients": "python3 Tools/export_ingredients.py",
    "ingredients:csv": "python3 Tools/export_ingredients.py --csv",
    "ingredients:push": "python3 Tools/export_ingredients.py --push",
    "charms": "python3 Tools/export_charms.py",
    "charms:csv": "python3 Tools/export_charms.py --csv",
    "charms:push": "python3 Tools/export_charms.py --push",
    "settings": "python3 Tools/export_settings.py",
    "settings:csv": "python3 Tools/export_settings.py --csv",
    "settings:push": "python3 Tools/export_settings.py --push",
    "spirits": "python3 Tools/export_spirits.py",
    "spirits:push": "python3 Tools/export_spirits.py --push",
    "sheets": "python3 Tools/pull_all_sheets.py",
    "sheets:describe": "python3 Tools/sheet_descriptions.py --apply"
  }
}
